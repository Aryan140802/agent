.deployments-24h {
  margin-top: 16px;
  background: #fff;
  border: 1px solid #e6e6e6;
  border-radius: 8px;
  padding: 16px;
  box-shadow: 0 2px 6px rgba(0,0,0,0.04);
}

.deployments-24h .panel-header {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 8px;
}

.deployments-24h h2 {
  font-size: 18px;
  margin: 0;
}

.badge {
  background: #eef4ff;
  color: #2a62ff;
  padding: 4px 10px;
  border-radius: 999px;
  font-weight: 600;
  font-size: 13px;
}

.stats {
  display: flex;
  gap: 16px;
  margin: 8px 0 12px;
  flex-wrap: wrap;
}

.stat {
  display: flex;
  gap: 6px;
  align-items: baseline;
  background: #f8f9fb;
  border: 1px solid #eee;
  border-radius: 6px;
  padding: 8px 12px;
}

.stat .label {
  color: #666;
  font-size: 12px;
}

.stat .value {
  font-weight: 600;
  font-size: 14px;
}

.stat .value.success { color: #1f9d55; } /* green */
.stat .value.failed  { color: #d43838; } /* red */

.deployments-list {
  display: grid;
  grid-template-columns: 1fr;
  gap: 8px;
}

.deployment-item {
  border: 1px solid #eee;
  border-radius: 6px;
  padding: 10px 12px;
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 8px;
}

.deployment-item .left {
  display: grid;
  gap: 4px;
}

.deployment-item .title {
  font-weight: 600;
  font-size: 14px;
}

.deployment-item .meta {
  color: #666;
  font-size: 12px;
}

.status-pill {
  align-self: center;
  padding: 4px 10px;
  border-radius: 999px;
  font-size: 12px;
  font-weight: 600;
}

.status-success { background: #eaf6ef; color: #1f9d55; }
.status-failed  { background: #fdecec; color: #d43838; }
.status-inprog  { background: #fff6e5; color: #b88000; }

.state.hidden { display: none; }
.hint { color: #666; font-size: 13px; }
