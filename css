/* -----------------------------
   RESET & BASE STYLES
------------------------------ */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: 'Segoe UI', 'Roboto', -apple-system, BlinkMacSystemFont, sans-serif;
    background: #0a0e27;
    background-image:
        radial-gradient(at 20% 30%, rgba(120, 0, 255, 0.15) 0px, transparent 50%),
        radial-gradient(at 80% 70%, rgba(0, 150, 255, 0.15) 0px, transparent 50%),
        radial-gradient(at 50% 50%, rgba(255, 0, 150, 0.1) 0px, transparent 50%);
    min-height: 100vh;
    padding: 20px;
    color: #e0e0e0;
    line-height: 1.6;
}

.container {
    max-width: 1400px;
    margin: 0 auto;
}

/* -----------------------------
   HEADER STYLES
------------------------------ */
.header {
    background: linear-gradient(135deg, rgba(30, 30, 60, 0.95) 0%, rgba(20, 20, 40, 0.95) 100%);
    border-radius: 24px;
    padding: 40px;
    margin-bottom: 25px;
    box-shadow:
        0 20px 60px rgba(0, 0, 0, 0.5),
        0 0 0 1px rgba(255, 255, 255, 0.05),
        inset 0 1px 0 rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.05);
}

.header-content {
    margin-bottom: 30px;
}

h1 {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 50%, #f093fb 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 8px;
    font-size: 2.8em;
    font-weight: 800;
    text-shadow: 0 0 30px rgba(102, 126, 234, 0.3);
    display: flex;
    align-items: center;
    gap: 15px;
}

.subtitle {
    color: rgba(255, 255, 255, 0.6);
    font-size: 1.1em;
    font-weight: 400;
    margin-left: 10px;
}

/* -----------------------------
   SEARCH SECTION
------------------------------ */
.search-section {
    position: relative;
}

.input-group {
    display: flex;
    gap: 15px;
    position: relative;
}

.search-icon {
    position: absolute;
    left: 25px;
    top: 50%;
    transform: translateY(-50%);
    color: rgba(255, 255, 255, 0.5);
    font-size: 1.2em;
    z-index: 2;
}

input[type="text"] {
    flex: 1;
    min-width: 300px;
    padding: 18px 25px 18px 60px;
    background: rgba(255, 255, 255, 0.05);
    border: 2px solid rgba(255, 255, 255, 0.1);
    border-radius: 16px;
    font-size: 16px;
    color: #e0e0e0;
    transition: all 0.3s ease;
    backdrop-filter: blur(10px);
    font-family: 'Segoe UI', sans-serif;
}

input[type="text"]::placeholder {
    color: rgba(255, 255, 255, 0.4);
}

input[type="text"]:focus {
    outline: none;
    border-color: #667eea;
    background: rgba(255, 255, 255, 0.08);
    box-shadow:
        0 0 0 3px rgba(102, 126, 234, 0.2),
        0 0 30px rgba(102, 126, 234, 0.3);
}

.search-btn {
    padding: 0 40px;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    border: none;
    border-radius: 16px;
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s;
    display: flex;
    align-items: center;
    gap: 10px;
    position: relative;
    overflow: hidden;
}

.search-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 15px 35px rgba(102, 126, 234, 0.5);
}

.search-btn:active {
    transform: translateY(0);
}

.btn-icon {
    font-size: 1.2em;
    transition: transform 0.3s;
}

.search-btn:hover .btn-icon {
    transform: translateX(5px);
}

.search-hint {
    color: rgba(255, 255, 255, 0.4);
    font-size: 0.9em;
    margin-top: 12px;
    margin-left: 10px;
    display: flex;
    align-items: center;
    gap: 8px;
}

/* -----------------------------
   MAIN LAYOUT
------------------------------ */
.main-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 25px;
}

/* -----------------------------
   RECENT PANEL STYLES
------------------------------ */
.recent-panel {
    background: linear-gradient(135deg, rgba(30, 30, 60, 0.95) 0%, rgba(20, 20, 40, 0.95) 100%);
    border-radius: 24px;
    padding: 40px;
    box-shadow:
        0 20px 60px rgba(0, 0, 0, 0.5),
        0 0 0 1px rgba(255, 255, 255, 0.05),
        inset 0 1px 0 rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.05);
}

.panel-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 30px;
}

.panel-title {
    display: flex;
    align-items: center;
    gap: 15px;
}

.panel-title h2 {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 50%, #f093fb 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    font-size: 1.8em;
    font-weight: 700;
    margin: 0;
}

.time-badge {
    background: rgba(102, 126, 234, 0.2);
    color: #667eea;
    padding: 6px 15px;
    border-radius: 20px;
    font-size: 0.85em;
    font-weight: 600;
    border: 1px solid rgba(102, 126, 234, 0.3);
}

.refresh-btn {
    background: rgba(255, 255, 255, 0.05);
    color: rgba(255, 255, 255, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    padding: 10px 20px;
    font-size: 0.95em;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.3s;
    display: flex;
    align-items: center;
    gap: 8px;
}

.refresh-btn:hover {
    background: rgba(102, 126, 234, 0.2);
    color: #667eea;
    border-color: rgba(102, 126, 234, 0.3);
    transform: translateY(-1px);
}

.refresh-icon {
    font-size: 1.1em;
}

/* -----------------------------
   RECENT STATS
------------------------------ */
.recent-stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 20px;
    margin-bottom: 30px;
}

.recent-stat {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    padding: 25px;
    display: flex;
    align-items: center;
    gap: 20px;
    transition: all 0.3s;
    position: relative;
    overflow: hidden;
}

.recent-stat::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, #667eea, #764ba2);
    opacity: 0;
    transition: opacity 0.3s;
}

.recent-stat:hover::before {
    opacity: 1;
}

.recent-stat:hover {
    background: rgba(255, 255, 255, 0.05);
    transform: translateY(-3px);
    border-color: rgba(102, 126, 234, 0.2);
}

.stat-icon {
    font-size: 2.2em;
    opacity: 0.8;
}

.stat-content {
    flex: 1;
}

.stat-content .value {
    font-size: 2.2em;
    font-weight: 800;
    margin-bottom: 4px;
    line-height: 1;
}

.stat-content .value.total { color: #667eea; }
.stat-content .value.success { color: #4CAF50; }
.stat-content .value.failed { color: #f44336; }
.stat-content .value.date { color: #f093fb; }

.stat-content .label {
    color: rgba(255, 255, 255, 0.6);
    font-size: 0.9em;
    font-weight: 500;
}

/* -----------------------------
   RECENT CONTENT
------------------------------ */
.recent-content {
    background: rgba(255, 255, 255, 0.02);
    border-radius: 16px;
    border: 1px solid rgba(255, 255, 255, 0.05);
    overflow: hidden;
}

.recent-list {
    min-height: 300px;
    max-height: 500px;
    overflow-y: auto;
    padding: 20px;
}

.empty-recent {
    text-align: center;
    padding: 60px 20px;
    color: rgba(255, 255, 255, 0.4);
}

.empty-icon {
    font-size: 4em;
    margin-bottom: 20px;
    opacity: 0.3;
}

.empty-recent h3 {
    color: rgba(255, 255, 255, 0.6);
    margin-bottom: 10px;
    font-size: 1.3em;
}

.empty-recent p {
    color: rgba(255, 255, 255, 0.4);
    margin-bottom: 20px;
}

.empty-hint {
    background: rgba(255, 255, 255, 0.03);
    border-radius: 12px;
    padding: 15px;
    margin-top: 20px;
    border: 1px solid rgba(255, 255, 255, 0.05);
}

/* -----------------------------
   RESULTS PANEL
------------------------------ */
.results-panel {
    display: none;
}

.results-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 25px;
}

.back-button {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    border: none;
    border-radius: 12px;
    padding: 12px 25px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s;
    display: flex;
    align-items: center;
    gap: 10px;
}

.back-button:hover {
    transform: translateX(-3px);
    box-shadow: 0 10px 25px rgba(102, 126, 234, 0.3);
}

.back-icon {
    font-size: 1.2em;
}

.current-server {
    background: rgba(102, 126, 234, 0.1);
    color: #667eea;
    padding: 10px 20px;
    border-radius: 12px;
    font-weight: 600;
    font-size: 1.1em;
    border: 1px solid rgba(102, 126, 234, 0.2);
}

/* -----------------------------
   WELCOME STATE
------------------------------ */
.welcome-state {
    text-align: center;
    padding: 80px 20px;
}

.welcome-icon {
    font-size: 5em;
    margin-bottom: 30px;
    opacity: 0.5;
}

.welcome-state h2 {
    color: rgba(255, 255, 255, 0.8);
    margin-bottom: 15px;
    font-size: 2em;
    font-weight: 700;
}

.welcome-state p {
    color: rgba(255, 255, 255, 0.5);
    margin-bottom: 40px;
    font-size: 1.1em;
}

.welcome-features {
    display: flex;
    justify-content: center;
    gap: 40px;
    flex-wrap: wrap;
    max-width: 600px;
    margin: 0 auto;
}

.feature {
    display: flex;
    align-items: center;
    gap: 10px;
    color: rgba(255, 255, 255, 0.6);
}

.feature-icon {
    font-size: 1.5em;
}

/* -----------------------------
   TABLE CONTAINER
------------------------------ */
.table-container {
    background: linear-gradient(135deg, rgba(30, 30, 60, 0.95) 0%, rgba(20, 20, 40, 0.95) 100%);
    border-radius: 24px;
    padding: 40px;
    box-shadow:
        0 20px 60px rgba(0, 0, 0, 0.5),
        0 0 0 1px rgba(255, 255, 255, 0.05),
        inset 0 1px 0 rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(10px);
    overflow-x: auto;
    border: 1px solid rgba(255, 255, 255, 0.05);
}

/* -----------------------------
   STATS CARDS
------------------------------ */
.stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 20px;
    margin-bottom: 30px;
}

.stat-card {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    padding: 25px;
    text-align: center;
    transition: all 0.3s;
    position: relative;
    overflow: hidden;
}

.stat-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, #667eea, #764ba2);
    opacity: 0;
    transition: opacity 0.3s;
}

.stat-card:hover::before {
    opacity: 1;
}

.stat-card:hover {
    background: rgba(255, 255, 255, 0.05);
    transform: translateY(-3px);
    border-color: rgba(102, 126, 234, 0.2);
}

.stat-card h3 {
    font-size: 2.5em;
    margin-bottom: 8px;
    background: linear-gradient(135deg, #667eea 0%, #f093fb 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    font-weight: 800;
}

.stat-card p {
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.95em;
    font-weight: 500;
}

/* -----------------------------
   FILTER CONTROLS
------------------------------ */
.filter-controls {
    background: rgba(255, 255, 255, 0.03);
    border-radius: 16px;
    padding: 25px;
    margin-bottom: 30px;
    border: 1px solid rgba(255, 255, 255, 0.08);
}

.filter-controls > div {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 20px;
    margin-bottom: 20px;
}

.filter-controls label {
    display: block;
    margin-bottom: 10px;
    color: rgba(255, 255, 255, 0.7);
    font-weight: 500;
    font-size: 0.95em;
}

.filter-controls select {
    width: 100%;
    padding: 12px 16px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 10px;
    color: #e0e0e0;
    font-size: 14px;
    cursor: pointer;
    transition: all 0.3s;
    font-family: 'Segoe UI', sans-serif;
}

.filter-controls select:focus {
    outline: none;
    border-color: #667eea;
    box-shadow: 0 0 0 2px rgba(102, 126, 234, 0.2);
}

.clear-filters-btn {
    background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
    color: white;
    border: none;
    border-radius: 10px;
    padding: 12px 25px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s;
    font-size: 14px;
}

.clear-filters-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 5px 15px rgba(245, 87, 108, 0.3);
}

/* -----------------------------
   TABLE STYLES
------------------------------ */
table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
}

thead {
    background: linear-gradient(135deg, rgba(102, 126, 234, 0.3) 0%, rgba(118, 75, 162, 0.3) 100%);
    position: relative;
}

thead::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, #667eea, #764ba2, transparent);
}

th {
    padding: 18px 16px;
    text-align: left;
    font-weight: 600;
    font-size: 0.9em;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: #e0e0e0;
    vertical-align: middle;
    border-bottom: 2px solid rgba(102, 126, 234, 0.3);
}

th:first-child {
    border-top-left-radius: 12px;
}

th:last-child {
    border-top-right-radius: 12px;
}

tbody tr {
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    transition: all 0.3s;
    position: relative;
}

tbody tr::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    height: 100%;
    width: 3px;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    opacity: 0;
    transition: opacity 0.3s;
}

tbody tr:hover {
    background: rgba(102, 126, 234, 0.1);
}

tbody tr:hover::before {
    opacity: 1;
}

td {
    padding: 18px 16px;
    color: #d0d0d0;
    vertical-align: middle;
}

.service-name {
    font-weight: 600;
    color: #667eea;
    font-size: 1.05em;
}

.file-info {
    color: rgba(255, 255, 255, 0.5);
    font-size: 0.85em;
    margin-top: 4px;
}

.time-cell {
    color: rgba(255, 255, 255, 0.7);
    font-family: 'Monaco', 'Menlo', monospace;
    font-size: 0.95em;
}

/* -----------------------------
   BADGE STYLES
------------------------------ */
.badge {
    display: inline-block;
    padding: 6px 14px;
    border-radius: 20px;
    font-size: 0.85em;
    font-weight: 600;
    backdrop-filter: blur(10px);
    border: 1px solid;
    transition: all 0.3s;
}

.badge:hover {
    transform: scale(1.05);
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.3);
}

.badge-broker {
    background: linear-gradient(135deg, rgba(118, 75, 162, 0.3) 0%, rgba(118, 75, 162, 0.2) 100%);
    color: #f093fb;
    border: 1px solid rgba(118, 75, 162, 0.4);
}

.badge-eg {
    background: linear-gradient(135deg, rgba(102, 126, 234, 0.3) 0%, rgba(102, 126, 234, 0.2) 100%);
    color: #667eea;
    border: 1px solid rgba(102, 126, 234, 0.4);
}

/* -----------------------------
   DATE SECTION STYLES
------------------------------ */
.date-section {
    background: rgba(255, 255, 255, 0.02);
    border-radius: 16px;
    padding: 25px;
    margin-bottom: 25px;
    border: 1px solid rgba(255, 255, 255, 0.05);
    transition: all 0.3s;
}

.date-section:hover {
    background: rgba(255, 255, 255, 0.03);
    border-color: rgba(102, 126, 234, 0.2);
}

.date-header {
    color: #667eea;
    border-bottom: 2px solid rgba(102, 126, 234, 0.3);
    padding-bottom: 15px;
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 1.2em;
    font-weight: 600;
}

.date-count {
    font-size: 0.8em;
    color: rgba(255, 255, 255, 0.5);
    background: rgba(102, 126, 234, 0.1);
    padding: 6px 12px;
    border-radius: 10px;
}

.date-table {
    width: 100%;
    border-collapse: collapse;
}

.date-table thead {
    background: rgba(102, 126, 234, 0.1);
}

.date-table th {
    padding: 14px 16px;
    font-size: 0.85em;
    border-bottom: 2px solid rgba(102, 126, 234, 0.2);
}

.date-table td {
    padding: 14px 16px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
}

/* -----------------------------
   ERROR & LOADING STATES
------------------------------ */
.error {
    background: rgba(255, 152, 0, 0.15);
    border: 1px solid rgba(255, 152, 0, 0.3);
    padding: 25px;
    border-radius: 16px;
    color: #ffb74d;
    backdrop-filter: blur(10px);
    text-align: center;
}

.error strong {
    display: block;
    margin-bottom: 10px;
    font-size: 1.1em;
}

.loading {
    text-align: center;
    padding: 60px 20px;
    font-size: 1.2em;
    color: #667eea;
}

.loading::after {
    content: '...';
    animation: dots 1.5s steps(4, end) infinite;
}

@keyframes dots {
    0%, 20% { content: '.'; }
    40% { content: '..'; }
    60%, 100% { content: '...'; }
}

/* -----------------------------
   SERVER SUGGESTIONS
------------------------------ */
.server-suggestions {
    position: absolute;
    background: linear-gradient(135deg, rgba(30, 30, 60, 0.98) 0%, rgba(20, 20, 40, 0.98) 100%);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 16px;
    box-shadow:
        0 20px 60px rgba(0, 0, 0, 0.5),
        0 0 0 1px rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(20px);
    z-index: 1000;
    max-height: 400px;
    overflow-y: auto;
    display: none;
    margin-top: 5px;
    width: 100%;
}

.suggestion-header {
    padding: 12px 20px;
    color: rgba(255, 255, 255, 0.5);
    font-size: 0.85em;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(0, 0, 0, 0.2);
    font-weight: 500;
}

.suggestion-item {
    padding: 12px 20px;
    color: #e0e0e0;
    cursor: pointer;
    transition: all 0.3s;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    font-size: 0.95em;
}

.suggestion-item:last-child {
    border-bottom: none;
}

.suggestion-item:hover {
    background: rgba(102, 126, 234, 0.2);
    color: #667eea;
    padding-left: 25px;
}

.suggestion-item strong {
    color: #667eea;
    font-weight: 700;
}

.suggestion-item.scan-item {
    color: #4CAF50;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    margin-top: 5px;
    padding-top: 15px;
}

.suggestion-item.scan-item:hover {
    background: rgba(76, 175, 80, 0.1);
    color: #4CAF50;
}

.suggestion-item.no-match {
    cursor: default;
    color: rgba(255, 255, 255, 0.5);
}

.suggestion-item.no-match:hover {
    background: transparent;
    padding-left: 20px;
    color: rgba(255, 255, 255, 0.5);
}

/* -----------------------------
   SERVER CHIP STYLES
------------------------------ */
.server-chip {
    background: rgba(102, 126, 234, 0.1);
    color: #667eea;
    padding: 10px 18px;
    border-radius: 12px;
    cursor: pointer;
    transition: all 0.3s;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border: 1px solid rgba(102, 126, 234, 0.2);
    font-size: 0.95em;
    margin: 5px;
}

.server-chip:hover {
    background: rgba(102, 126, 234, 0.2);
    transform: translateY(-2px);
    box-shadow: 0 5px 15px rgba(102, 126, 234, 0.1);
}

.server-ip {
    font-weight: 500;
}

.server-badge {
    background: rgba(255, 255, 255, 0.1);
    color: rgba(255, 255, 255, 0.7);
    padding: 3px 10px;
    border-radius: 10px;
    font-size: 0.85em;
    font-weight: 600;
}

/* -----------------------------
   AVAILABLE SERVERS LIST
------------------------------ */
.available-servers {
    margin-top: 20px;
}

.servers-header {
    margin-bottom: 25px;
    padding-bottom: 15px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
}

.servers-header h3 {
    color: #e0e0e0;
    font-size: 1.3em;
    margin-bottom: 5px;
}

.scan-info {
    color: rgba(255, 255, 255, 0.5);
    font-size: 0.9em;
}

.servers-grid {
    display: grid;
    gap: 25px;
}

.subnet-group {
    background: rgba(255, 255, 255, 0.02);
    border-radius: 16px;
    padding: 20px;
    border: 1px solid rgba(255, 255, 255, 0.05);
}

.subnet-header {
    color: #667eea;
    font-weight: 600;
    margin-bottom: 15px;
    font-size: 0.95em;
    text-transform: uppercase;
    letter-spacing: 1px;
    display: flex;
    align-items: center;
    gap: 10px;
}

.subnet-header::before {
    content: '📡';
    font-size: 1.1em;
}

.server-list {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
}

.servers-footer {
    margin-top: 30px;
    padding-top: 20px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    text-align: center;
}

.rescan-btn {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    border: none;
    border-radius: 12px;
    padding: 12px 25px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s;
    font-size: 14px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
}

.rescan-btn:hover:not(:disabled) {
    transform: translateY(-2px);
    box-shadow: 0 5px 15px rgba(102, 126, 234, 0.3);
}

.rescan-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
}

/* -----------------------------
   FOOTER
------------------------------ */
.footer {
    margin-top: 30px;
    padding-top: 20px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
}

.footer-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: rgba(255, 255, 255, 0.4);
    font-size: 0.9em;
}

.footer-info {
    display: flex;
    align-items: center;
    gap: 10px;
}

.footer-icon {
    font-size: 1.2em;
}

.footer-stats {
    background: rgba(255, 255, 255, 0.05);
    padding: 6px 15px;
    border-radius: 12px;
    font-weight: 500;
}

/* -----------------------------
   LOADING OVERLAY
------------------------------ */
.loading-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(10, 14, 39, 0.9);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 9999;
    backdrop-filter: blur(10px);
}

/* -----------------------------
   RESPONSIVE STYLES
------------------------------ */
@media (max-width: 1200px) {
    .container {
        padding: 15px;
    }
    
    .header {
        padding: 30px;
    }
    
    h1 {
        font-size: 2.3em;
    }
}

@media (max-width: 992px) {
    .recent-stats {
        grid-template-columns: repeat(2, 1fr);
    }
    
    .stats {
        grid-template-columns: repeat(2, 1fr);
    }
    
    .welcome-features {
        flex-direction: column;
        gap: 20px;
        align-items: center;
    }
}

@media (max-width: 768px) {
    .input-group {
        flex-direction: column;
    }
    
    input[type="text"] {
        width: 100%;
        min-width: auto;
    }
    
    .search-btn {
        width: 100%;
        justify-content: center;
        padding: 18px;
    }
    
    .recent-stats,
    .stats {
        grid-template-columns: 1fr;
    }
    
    .panel-header {
        flex-direction: column;
        gap: 15px;
        align-items: flex-start;
    }
    
    .results-header {
        flex-direction: column;
        gap: 15px;
        align-items: flex-start;
    }
    
    .back-button {
        width: 100%;
        justify-content: center;
    }
    
    .footer-content {
        flex-direction: column;
        gap: 15px;
        text-align: center;
    }
    
    h1 {
        font-size: 2em;
    }
    
    .header {
        padding: 25px;
    }
    
    .table-container,
    .recent-panel {
        padding: 25px;
    }
    
    th, td {
        padding: 12px 10px;
        font-size: 0.9em;
    }
    
    .date-section {
        padding: 20px;
    }
}

@media (max-width: 480px) {
    .container {
        padding: 10px;
    }
    
    .header {
        padding: 20px;
        border-radius: 20px;
    }
    
    h1 {
        font-size: 1.8em;
    }
    
    .panel-title h2 {
        font-size: 1.5em;
    }
    
    .recent-stat,
    .stat-card {
        padding: 20px;
    }
    
    .stat-content .value {
        font-size: 1.8em;
    }
    
    .stat-icon {
        font-size: 1.8em;
    }
}

/* -----------------------------
   SCROLLBAR STYLING
------------------------------ */
::-webkit-scrollbar {
    width: 10px;
    height: 10px;
}

::-webkit-scrollbar-track {
    background: rgba(255, 255, 255, 0.05);
    border-radius: 5px;
}

::-webkit-scrollbar-thumb {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    border-radius: 5px;
}

::-webkit-scrollbar-thumb:hover {
    background: linear-gradient(135deg, #7b8ef0 0%, #8b5bb2 100%);
}
