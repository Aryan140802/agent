<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Deployment Tracker</title>
    <link rel="stylesheet" href="main.css">
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>Deployment Tracker</h1>
            <div class="input-group">
                <input type="text" id="ipInput" placeholder="Enter IP Address (e.g., 10.188.25.163)" value="">
                <button onclick="loadDeployment()">Load Deployment</button>
            </div>
            
            <!-- Recent Deployments Panel -->
            <div class="recent-deployments-panel" id="recentDeploymentsPanel">
                <h3>📋 Recent Deployments (Last 24 Hours)</h3>
                <div class="recent-stats">
                    <div class="recent-stat">
                        <span class="stat-value" id="recentTotal">0</span>
                        <span class="stat-label">Total</span>
                    </div>
                    <div class="recent-stat success">
                        <span class="stat-value" id="recentSuccess">0</span>
                        <span class="stat-label">Success</span>
                    </div>
                    <div class="recent-stat failed">
                        <span class="stat-value" id="recentFailed">0</span>
                        <span class="stat-label">Failed</span>
                    </div>
                </div>
                <div id="recentList" class="recent-list">
                    <div class="empty-state-small" id="recentEmpty">
                        <p>No deployments in the last 24 hours</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="table-container" id="contentArea">
            <div class="empty-state">
                <svg viewBox="0 0 24 24" fill="currentColor">
                    <path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zM9 17H7v-7h2v7zm4 0h-2V7h2v10zm4 0h-2v-4h2v4z"/>
                </svg>
                <h2>No Data Loaded</h2>
                <p>Enter an IP address and click "Load Deployment" to view deployment data</p>
            </div>
        </div>
    </div>
    <script src="main.js"></script>
</body>
</html>
