<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Deployment Tracker</title>
    <link rel="stylesheet" href="main.css">
    <style>
        /* Additional styles for the two-panel layout */
        .main-layout {
            display: grid;
            grid-template-columns: 1fr;
            gap: 25px;
            margin-top: 20px;
        }
        
        .recent-panel {
            background: linear-gradient(135deg, rgba(30, 30, 60, 0.95) 0%, rgba(20, 20, 40, 0.95) 100%);
            border-radius: 20px;
            padding: 35px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5),
                        0 0 0 1px rgba(255, 255, 255, 0.05),
                        inset 0 1px 0 rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.05);
        }
        
        .results-panel {
            display: none; /* Hidden until search */
        }
        
        .panel-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 25px;
        }
        
        .panel-header h2 {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 50%, #f093fb 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            font-size: 1.8em;
            font-weight: 600;
        }
        
        .recent-stats {
            display: flex;
            gap: 20px;
            margin-bottom: 30px;
            flex-wrap: wrap;
        }
        
        .recent-stat {
            flex: 1;
            min-width: 150px;
            padding: 20px;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 15px;
            text-align: center;
            transition: all 0.3s;
        }
        
        .recent-stat:hover {
            background: rgba(102, 126, 234, 0.1);
            transform: translateY(-3px);
            border-color: rgba(102, 126, 234, 0.3);
        }
        
        .recent-stat .value {
            font-size: 2.2em;
            font-weight: 700;
            margin-bottom: 5px;
        }
        
        .recent-stat .value.total { color: #667eea; }
        .recent-stat .value.success { color: #4CAF50; }
        .recent-stat .value.failed { color: #f44336; }
        
        .recent-stat .label {
            color: rgba(255, 255, 255, 0.7);
            font-size: 0.9em;
        }
        
        .recent-list {
            display: grid;
            gap: 12px;
            max-height: 500px;
            overflow-y: auto;
            padding-right: 10px;
        }
        
        .recent-item {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 12px;
            padding: 18px;
            display: grid;
            grid-template-columns: 1fr auto;
            gap: 15px;
            align-items: center;
            transition: all 0.3s;
        }
        
        .recent-item:hover {
            background: rgba(102, 126, 234, 0.1);
            transform: translateX(5px);
            border-color: rgba(102, 126, 234, 0.3);
        }
        
        .recent-info .service {
            font-weight: 600;
            color: #e0e0e0;
            margin-bottom: 5px;
            font-size: 1.1em;
        }
        
        .recent-info .details {
            color: rgba(255, 255, 255, 0.6);
            font-size: 0.9em;
        }
        
        .recent-status {
            padding: 8px 16px;
            border-radius: 20px;
            font-size: 0.85em;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        
        .status-success {
            background: rgba(76, 175, 80, 0.2);
            color: #4CAF50;
            border: 1px solid rgba(76, 175, 80, 0.3);
        }
        
        .status-failed {
            background: rgba(244, 67, 54, 0.2);
            color: #f44336;
            border: 1px solid rgba(244, 67, 54, 0.3);
        }
        
        .status-pending {
            background: rgba(255, 193, 7, 0.2);
            color: #FFC107;
            border: 1px solid rgba(255, 193, 7, 0.3);
        }
        
        .empty-recent {
            text-align: center;
            padding: 50px 20px;
            color: rgba(255, 255, 255, 0.4);
        }
        
        .empty-recent svg {
            width: 80px;
            height: 80px;
            margin-bottom: 20px;
            opacity: 0.3;
        }
        
        .back-button {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border: none;
            border-radius: 12px;
            padding: 12px 25px;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 20px;
        }
        
        .back-button:hover {
            transform: translateX(-3px);
            box-shadow: 0 10px 25px rgba(102, 126, 234, 0.3);
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>Deployment Tracker</h1>
            <div class="input-group">
                <input type="text" id="ipInput" placeholder="Enter Server IP (e.g., 10.188.25.163)" value="">
                <button onclick="searchDeployments()">Search Deployments</button>
            </div>
        </div>
        
        <!-- Recent Deployments Panel (Always Visible) -->
        <div class="recent-panel">
            <div class="panel-header">
                <h2>Recent Deployments (Last 24 Hours)</h2>
                <div class="recent-stats">
                    <div class="recent-stat">
                        <div class="value total" id="totalCount">0</div>
                        <div class="label">Total</div>
                    </div>
                    <div class="recent-stat">
                        <div class="value success" id="successCount">0</div>
                        <div class="label">Successful</div>
                    </div>
                    <div class="recent-stat">
                        <div class="value failed" id="failedCount">0</div>
                        <div class="label">Failed</div>
                    </div>
                </div>
            </div>
            
            <div class="recent-list" id="recentList">
                <div class="empty-recent">
                    <svg viewBox="0 0 24 24" fill="currentColor">
                        <path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zM9 17H7v-7h2v7zm4 0h-2V7h2v10zm4 0h-2v-4h2v4z"/>
                    </svg>
                    <h3>No recent deployments</h3>
                    <p>Search for a server IP to see deployment history</p>
                </div>
            </div>
        </div>
        
        <!-- Search Results Panel (Hidden until search) -->
        <div class="results-panel" id="resultsPanel">
            <button class="back-button" onclick="showRecentPanel()">
                ← Back to Recent Deployments
            </button>
            
            <div class="table-container" id="contentArea">
                <div class="empty-state">
                    <svg viewBox="0 0 24 24" fill="currentColor">
                        <path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zM9 17H7v-7h2v7zm4 0h-2V7h2v10zm4 0h-2v-4h2v4z"/>
                    </svg>
                    <h2>No Data Loaded</h2>
                    <p>Enter a server IP and click "Search Deployments" to view deployment data</p>
                </div>
            </div>
        </div>
    </div>

    <script src="main.js"></script>
</body>
</html>
